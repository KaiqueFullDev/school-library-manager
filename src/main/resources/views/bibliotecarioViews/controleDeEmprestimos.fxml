<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifba.controller.features.bibliotecario.ControleDeEmprestimosController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: #1A3783;">
            <padding><Insets left="40.0" right="40.0" /></padding>
            <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label style="-fx-text-fill: white; -fx-font-size: 14px;" text="Bem Vindo" />
                <Label fx:id="NomeUsuario" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px;" text="Bibliotecário" />
            </VBox>
            <ImageView fitHeight="50.0" preserveRatio="true"><Image url="@../../images/logo.png" /></ImageView>
            <ImageView fitHeight="35.0" onMouseClicked="#handleLogout" style="-fx-cursor: hand;"><Image url="@../../images/botaoSeta.jpeg" /><HBox.margin><Insets left="20.0"/></HBox.margin></ImageView>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #E9EEF7; -fx-background: #E9EEF7;">
            <content>
                <VBox spacing="20.0">
                    <padding><Insets bottom="100.0" left="40.0" right="40.0" top="30.0" /></padding>
                    <VBox spacing="5.0">
                        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" text="Painel de Devoluções" />
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 16px;" text="Visualize e registre a devolução de livros emprestados." />
                    </VBox>

                    <FlowPane fx:id="containerDevolucoes" hgap="30.0" vgap="30.0" alignment="TOP_LEFT" />
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" prefHeight="90.0" style="-fx-background-color: white; -fx-border-color: #D1D1D1 transparent transparent transparent;">
            <HBox spacing="60" alignment="CENTER" HBox.hgrow="ALWAYS">
                <ImageView fitHeight="55.0" onMouseClicked="#dashboardController" style="-fx-cursor: hand;"><Image url="@../../images/botaoDashboard.jpeg" /></ImageView>
                <ImageView fitHeight="55.0" onMouseClicked="#inventarioController" style="-fx-cursor: hand;"><Image url="@../../images/botaoInventario.jpeg" /></ImageView>
                <ImageView fitHeight="55.0" onMouseClicked="#controleDeReservasController" style="-fx-cursor: hand;"><Image url="@../../images/botaoFilaDeReserva.jpeg" /></ImageView>
                <ImageView fitHeight="55.0" onMouseClicked="#controleDeEmprestimosController" style="-fx-cursor: hand;"><Image url="@../../images/botaoDevolucoes.jpeg" /></ImageView>
            </HBox>
        </HBox>
    </bottom>
</BorderPane>